<Window x:Class="ZoneTune.UI.RecommendedSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Review recommended settings" Width="820" Height="720" WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize" Background="{StaticResource Bg}" ShowInTaskbar="False">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A0E0B" BorderBrush="#1B251E" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Amber}" VerticalAlignment="Center"/>
                    <TextBlock Text="Review recommended settings" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#x2715;" FontFamily="Segoe UI" FontSize="13" HorizontalAlignment="Right" Width="44" Height="30" Margin="0,0,8,0"
                        Style="{StaticResource WindowButton}" Click="Cancel_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Padding="22,16,22,14" Background="#0F1511" BorderBrush="#1B251E" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="RECOMMENDED IN-GAME PROFILE" Style="{StaticResource Overline}"/>
                <TextBlock x:Name="SummaryText" Style="{StaticResource H3}" FontSize="15" Margin="0,5,0,0"/>
                <TextBlock x:Name="HardwareText" Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                <WrapPanel x:Name="BadgePanel" Margin="0,9,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="22,12,22,0">
            <StackPanel>
                <TextBlock Text="These are the exact settings that will be written. Uncheck anything you do not want. Nothing is written until you press Apply."
                           Style="{StaticResource BodyDim}" Margin="0,0,0,10"/>
                <Grid Margin="0,0,10,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="SETTING" Style="{StaticResource Overline}"/>
                    <TextBlock Grid.Column="2" Text="CURRENT" Style="{StaticResource Overline}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="RECOMMENDED" Style="{StaticResource Overline}" HorizontalAlignment="Right"/>
                </Grid>
                <StackPanel x:Name="RowsPanel"/>
                <StackPanel x:Name="ManualPanel" Margin="0,10,0,0"/>
                <Border Background="#1A150D" BorderBrush="#3A2F18" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,12,0,4">
                    <StackPanel>
                        <TextBlock Text="What this does not do" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                        <TextBlock Text="It does not enable DLSS/FSR/XeSS, change HDR, or touch mods. The upscaler must be selected in the game's display menu. Effects are hardware-derived estimates, not measured guarantees."
                                   FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="22,12" Background="#0B0F0C" BorderBrush="#1B251E" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectionText" Text="" FontSize="11" Foreground="{StaticResource Dim}"/>
                    <TextBlock Text="A timestamped backup is created first. Restore it from Settings &amp; Backups." FontSize="9.5" Foreground="#5F6F62" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ButtonBase}" Content="Cancel" Click="Cancel_Click" Padding="16,9" Margin="0,0,8,0"/>
                    <Button x:Name="ApplyButton" Style="{StaticResource PrimaryButton}" Content="Apply settings" Click="Apply_Click" Padding="18,9"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

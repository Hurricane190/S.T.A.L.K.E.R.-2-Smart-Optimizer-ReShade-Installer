<UserControl x:Class="ZoneTune.UI.Views.ReShadeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,34">
            <ContentControl x:Name="StatusHost"/>
            <WrapPanel x:Name="NoticePanel" Margin="0,12,0,0"/>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox" Width="240" Height="32" TextChanged="Search_Changed" ToolTip="Filter presets by name, author or style"/>
                        <ComboBox x:Name="FilterCombo" Width="230" Height="32" Margin="10,0,0,0" SelectionChanged="Filter_Changed"
                                  ToolTip="Filter presets by visual ambition vs. performance cost">
                            <ComboBoxItem Content="All performance levels" IsSelected="True"/>
                            <ComboBoxItem Content="High performance · low detail"/>
                            <ComboBoxItem Content="Balanced"/>
                            <ComboBoxItem Content="Ultra detail · high cost"/>
                            <ComboBoxItem Content="Bundled"/>
                            <ComboBoxItem Content="Author pages"/>
                            <ComboBoxItem Content="Direct download"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonBase}" Content="Import preset file" Click="Import_Click" Margin="0,0,8,0" Padding="12,7"/>
                        <Button x:Name="PublicSearchButton" Style="{StaticResource ButtonBase}" Click="PublicSearch_Click" Padding="12,7">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Search public sources" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRESET CATALOG" Style="{StaticResource Overline}"/>
                    <TextBlock x:Name="CatalogSubtitle" Text="Bundled presets are authored by ZoneTune; third-party entries link to the author's page." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CatalogCount" Text="" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
            </Grid>

            <StackPanel x:Name="CatalogPanel" Margin="0,12,0,0"/>

            <Border x:Name="ProgressCard" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0" Visibility="Collapsed">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ProgressTitle" Text="Working…" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ProgressPercent" Grid.Column="1" Text="" FontSize="10.5" Foreground="{StaticResource Dim}"/>
                    </Grid>
                    <ProgressBar x:Name="ProgressBar" Margin="0,9,0,0" Height="4" IsIndeterminate="True"/>
                    <TextBlock x:Name="ProgressDetail" Text="" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#0F1511" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="COMPATIBILITY, HONESTLY" Style="{StaticResource Overline}"/>
                    <TextBlock Text="ZoneTune calls a preset 'structurally verified' only when the preset parses and every referenced shader file exists on this PC. That is not a visual test, and it does not prove a frame-rate cost. Third-party presets on Nexus Mods are linked — never repackaged or auto-downloaded — because their authors control distribution. GitHub presets are offered for direct install only when the repository carries an explicit permissive license."
                               Style="{StaticResource BodyDim}" Margin="0,5,0,0"/>
                    <TextBlock Text="ReShade itself is downloaded from reshade.me, checked against the published SHA-256 and certificate thumbprint, and installed with its official headless setup. HDR + ReShade is flagged on every preset because most effects assume SDR."
                               Style="{StaticResource BodyDim}" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

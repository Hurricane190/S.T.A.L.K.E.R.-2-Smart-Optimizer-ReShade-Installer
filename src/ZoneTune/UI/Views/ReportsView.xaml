<UserControl x:Class="ZoneTune.UI.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,34">
            <Border Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="DIAGNOSTIC REPORT" Style="{StaticResource Overline}"/>
                        <TextBlock x:Name="SummaryText" Text="Run a scan to build a report from this PC." Style="{StaticResource H3}" Margin="0,5,0,0"/>
                        <TextBlock Text="Reports contain local paths and hardware details. Review before sharing." FontSize="10" Foreground="{StaticResource Dim}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonBase}" Content="Export HTML" Click="Export_Click" Padding="12,7" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ButtonBase}" Content="Open reports folder" Click="OpenFolder_Click" Padding="12,7" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Rescan" Click="Rescan_Click" Padding="14,8"/>
                    </StackPanel>
                </Grid>
            </Border>

            <UniformGrid x:Name="StatsGrid" Columns="4" Margin="0,14,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="MEASUREMENT" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Import PresentMon CSV captures. Without a before/after, every performance claim stays an estimate." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Import PresentMon CSV" Click="ImportMeasurement_Click" Padding="12,7" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0" x:Name="BeforeHost" Margin="0,0,7,0"/>
                <ContentControl Grid.Column="1" x:Name="AfterHost" Margin="7,0,0,0"/>
            </Grid>
            <ContentControl x:Name="ComparisonHost" Margin="0,10,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="FINDINGS" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Evidence is read-only. Fix the cause, then rescan and measure." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <ComboBox Grid.Column="1" x:Name="SeverityFilter" Width="160" Height="30" SelectionChanged="Severity_Changed">
                    <ComboBoxItem Content="All severities" IsSelected="True"/>
                    <ComboBoxItem Content="Critical only"/>
                    <ComboBoxItem Content="Warnings+"/>
                    <ComboBoxItem Content="Notices+"/>
                </ComboBox>
            </Grid>
            <StackPanel x:Name="FindingsPanel" Margin="0,12,0,0"/>

            <Border Background="#0F1511" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="MEASUREMENT PROTOCOL" Style="{StaticResource Overline}"/>
                    <TextBlock Text="1. Load the same save, stand in the same spot, and use the same route for both captures." Style="{StaticResource BodyDim}" Margin="0,6,0,0"/>
                    <TextBlock Text="2. Capture at least 60 seconds after shader warm-up. Close browsers, launchers and overlays you do not need." Style="{StaticResource BodyDim}" Margin="0,3,0,0"/>
                    <TextBlock Text="3. Change one thing (config, preset, upscaler). Capture again with identical settings." Style="{StaticResource BodyDim}" Margin="0,3,0,0"/>
                    <TextBlock Text="4. Compare 1% / 0.1% lows and the 99th percentile frame time — not just average FPS. A higher average with worse lows can feel worse." Style="{StaticResource BodyDim}" Margin="0,3,0,0"/>
                    <TextBlock Text="PresentMon: Intel's free tool (github.com/GameTechDev/PresentMon). Capture to CSV, then import here." Style="{StaticResource BodyDim}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

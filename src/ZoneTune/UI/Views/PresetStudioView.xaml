<UserControl x:Class="ZoneTune.UI.Views.PresetStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,34">
            <Border Style="{StaticResource Card}" Padding="20" Background="#101711">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="YOUR OWN RESHADE LOOK" Style="{StaticResource Overline}"/>
                        <TextBlock Text="Preset Studio" Style="{StaticResource H1}" FontSize="28"/>
                        <TextBlock Text="Start from a Potato, Medium or High baseline. Every effect is optional. The app checks the shader files and backs up the previous ReShade state on install."
                                   Style="{StaticResource BodyDim}" Margin="0,5,0,0" MaxWidth="760" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="HardwareText" Style="{StaticResource BodyDim}" Margin="0,8,0,0" Foreground="#A9B8AA"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Border Style="{StaticResource Chip}" Background="#1B2518" BorderBrush="#33452F" HorizontalAlignment="Right">
                            <TextBlock x:Name="RecommendedBadge" Text="RECOMMENDED: —" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                        </Border>
                        <Button x:Name="UndoButton" Style="{StaticResource ButtonBase}" Content="Undo last preset install" Click="Undo_Click"
                                Margin="0,8,0,0" Padding="13,7" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="1 · PICK A BASELINE" Style="{StaticResource Overline}"/>
                    <TextBlock Text="The mode sets sensible defaults. You can change every toggle below afterwards." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
            <UniformGrid x:Name="ModeGrid" Columns="3" Margin="0,12,0,0"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18" Margin="0,0,9,0">
                    <StackPanel>
                        <TextBlock Text="2 · CUSTOMIZE" Style="{StaticResource Overline}"/>
                        <TextBlock Text="NAME" Style="{StaticResource Overline}" Margin="0,14,0,0"/>
                        <TextBox x:Name="NameBox" Height="34" Margin="0,6,0,0" Text="My Zone Look" TextChanged="Name_Changed"/>
                        <TextBlock Text="EFFECTS" Style="{StaticResource Overline}" Margin="0,16,0,0"/>
                        <TextBlock Text="Effects that are above your selected mode's budget are flagged. Nothing is applied until you press Install."
                                   Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                        <StackPanel x:Name="EffectsPanel" Margin="0,8,0,0"/>
                        <TextBlock Text="All effects are official reshade-shaders. No author preset is copied or repackaged."
                                   FontSize="9.5" Foreground="#5E6E61" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18" Margin="9,0,0,0">
                    <StackPanel>
                        <TextBlock Text="STRENGTHS" Style="{StaticResource Overline}"/>
                        <TextBlock Text="Conservative values are a starting point; test in-game before judging cost or look."
                                   Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Colour" FontSize="11" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="ColourSlider" Minimum="0" Maximum="0.4" Value="0.12" ValueChanged="Slider_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="ColourValue" Text="0.12" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Sharpen" FontSize="11" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="SharpenSlider" Minimum="0" Maximum="1" Value="0.32" ValueChanged="Slider_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="SharpenValue" Text="0.32" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Filmic" FontSize="11" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="FilmSlider" Minimum="0" Maximum="1" Value="0.4" ValueChanged="Slider_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="FilmValue" Text="0.40" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Bloom" FontSize="11" VerticalAlignment="Center"/>
                            <Slider Grid.Column="1" x:Name="BloomSlider" Minimum="0" Maximum="0.5" Value="0.16" ValueChanged="Slider_Changed"/>
                            <TextBlock Grid.Column="2" x:Name="BloomValue" Text="0.16" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Background="#0F1511" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Padding="11,8" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="MODE BUDGET" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="BudgetText" Text="" Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="WarningPanel" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="18" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="3 · PREVIEW &amp; INSTALL" Style="{StaticResource Overline}"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="ORIGINAL (SYNTHETIC)" Style="{StaticResource Overline}" FontSize="8.5"/>
                                <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0" ClipToBounds="True">
                                    <Image x:Name="OriginalImage" Height="130" Stretch="UniformToFill"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="YOUR PRESET" Style="{StaticResource Overline}" FontSize="8.5"/>
                                <Border BorderBrush="{StaticResource AmberDim}" BorderThickness="1" CornerRadius="7" Margin="0,4,0,0" ClipToBounds="True">
                                    <Image x:Name="ProcessedImage" Height="130" Stretch="UniformToFill"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Illustrative colour preview from a synthetic scene, not a game screenshot. It cannot prove in-game compatibility or frame cost."
                                   FontSize="9.5" Foreground="#5E6E61" Margin="0,7,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="18,0,0,0">
                        <TextBlock x:Name="PreviewName" Style="{StaticResource H3}" FontSize="15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border x:Name="PreviewStatus" Style="{StaticResource Chip}" Background="#1D180D" BorderBrush="#3A2F18">
                                <TextBlock x:Name="PreviewStatusText" Text="ESTIMATED" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource Amber}"/>
                            </Border>
                            <TextBlock x:Name="PreviewTechCount" Text="" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="PreviewCost" Text="" FontSize="10.5" Foreground="{StaticResource Text}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Estimated cost, not measured. Test the same route before/after." FontSize="9" Foreground="#5E6E61" Margin="0,2,0,0"/>
                        <StackPanel x:Name="InstallMessages" Margin="0,8,0,0"/>
                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install this preset" Click="Install_Click" Padding="14,10" Margin="0,10,0,0"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource ButtonBase}" Content="Save .ini" Click="Save_Click" Margin="0,0,4,0" Padding="10,7"/>
                            <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Export…" Click="Export_Click" Margin="4,0,0,0" Padding="10,7"/>
                        </Grid>
                        <Button Style="{StaticResource GhostButton}" Content="Open my presets folder →" Click="OpenPresets_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="Reminder: ReShade is optional and adds GPU cost. Potato uses the smallest stack; High adds bloom and filmic contrast. Nothing here is promised to be lag-free."
                       FontSize="10" Foreground="#637266" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="ZoneTune.UI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,34">
            <Border x:Name="HeroCard" Style="{StaticResource Card}" Padding="24" Background="#101711">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" MaxWidth="690" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource Chip}" Background="#1B2518" BorderBrush="#33452F" Margin="0,0,8,10">
                                <TextBlock x:Name="HeroTag" Text="ZONE READINESS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                            </Border>
                            <TextBlock x:Name="HeroScanTime" Text="" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,0,10"/>
                        </StackPanel>
                        <TextBlock x:Name="HeroTitle" Text="Your Zone, understood." Style="{StaticResource H1}" FontSize="30"/>
                        <TextBlock x:Name="HeroBody" Text="Scan the installation to map hardware, game configuration, mods and ReShade. Nothing is changed until you approve a plan."
                                   Style="{StaticResource BodyDim}" Margin="0,8,0,0"/>
                        <StackPanel x:Name="HeroActions" Orientation="Horizontal" Margin="0,18,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" x:Name="HeroStats" VerticalAlignment="Center" Margin="24,0,0,0"/>
                </Grid>
            </Border>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="SYSTEM SNAPSHOT" Style="{StaticResource Overline}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Export report →" Click="OpenReports_Click" FontSize="11"/>
            </Grid>
            <UniformGrid x:Name="SystemGrid" Columns="4" Margin="0,8,0,0"/>
            <ContentControl x:Name="ProfileCardHost" Margin="0,14,0,0"/>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WHAT IS BOTHERING YOU?" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Select one or more. The plan will explain every change before anything is written." Style="{StaticResource BodyDim}" Margin="0,5,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" x:Name="OptimizeSelectedButton" Style="{StaticResource PrimaryButton}" Content="Optimize selected →"
                        Click="OptimizeSelected_Click" VerticalAlignment="Bottom" Padding="16,9"/>
            </Grid>
            <UniformGrid x:Name="ProblemGrid" Columns="3" Margin="0,12,0,0"/>

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="TOP FINDINGS" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="FindingsPanel"/>
                    <Button Style="{StaticResource GhostButton}" Content="Open full diagnostic report →" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="OpenReports_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="ENVIRONMENT" Style="{StaticResource Overline}" Margin="0,0,0,8"/>
                    <StackPanel x:Name="EnvironmentPanel"/>
                    <StackPanel x:Name="QuickActionsPanel" Orientation="Horizontal" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="Estimates only. ZoneTune never promises an FPS gain; import a before/after PresentMon capture to verify."
                       FontSize="10.5" Foreground="#637266" Margin="0,22,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

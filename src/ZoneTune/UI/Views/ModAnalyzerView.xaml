<UserControl x:Class="ZoneTune.UI.Views.ModAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,0,30,34">
            <ContentControl x:Name="SummaryHost"/>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="STATIC MOD INSPECTION" Style="{StaticResource Overline}"/>
                        <TextBlock x:Name="AnalyzeStatusText" Text="Scan installed mods to inspect archives, Lua scripts, native files and overlaps. Read-only until you confirm quarantine."
                                   Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                        <ProgressBar x:Name="AnalyzeProgress" Margin="0,8,0,0" Height="3" IsIndeterminate="True" Visibility="Collapsed"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click" Padding="14,8" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Scan Mods" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="QuarantineButton" Style="{StaticResource DangerButton}" Content="Quarantine Selected" Click="Quarantine_Click" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button x:Name="RestoreAllButton" Style="{StaticResource ButtonBase}" Content="Restore Quarantined Mods" Click="RestoreAll_Click" Padding="12,7" Margin="0,0,8,0" IsEnabled="False"/>
                        <Button Style="{StaticResource ButtonBase}" Content="Open quarantine" Click="OpenQuarantine_Click" Padding="12,7"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Background="#121811" BorderBrush="#2A362B" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="EVIDENCE FIRST — NO FPS PROMISES" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Risk labels describe static indicators found in the files, not measured FPS drops or stuttering. A HIGH result means a strong hypothesis (for example, a 50 ms script loop plus repeated actor queries), not proof. File size alone is never treated as a performance problem. The only way to attribute a change is a controlled before/after capture with PresentMon."
                               Style="{StaticResource BodyDim}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SearchBox" Width="250" Height="32" TextChanged="Search_Changed" ToolTip="Filter mods by name, path, version or summary"/>
                        <ComboBox x:Name="FilterCombo" Width="215" Height="32" Margin="10,0,0,0" SelectionChanged="Filter_Changed">
                            <ComboBoxItem Content="All mods" IsSelected="True"/>
                            <ComboBoxItem Content="Flagged (high/medium/unknown)"/>
                            <ComboBoxItem Content="High risk"/>
                            <ComboBoxItem Content="Medium risk"/>
                            <ComboBoxItem Content="Low risk"/>
                            <ComboBoxItem Content="Unknown"/>
                            <ComboBoxItem Content="Ignored"/>
                            <ComboBoxItem Content="UE4SS"/>
                            <ComboBoxItem Content="Scripts"/>
                            <ComboBoxItem Content="Pak / IoStore"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ButtonBase}" Content="Select all eligible" Click="SelectAll_Click" Padding="10,6" Margin="0,0,6,0"/>
                        <Button Style="{StaticResource ButtonBase}" Content="Clear selection" Click="ClearSelection_Click" Padding="10,6"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="INSTALLED MODS" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Each row separates inspected facts from the performance hypothesis. Expand a row for the full evidence trail." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CountText" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
            </Grid>

            <StackPanel x:Name="ListPanel" Margin="0,12,0,0"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="OVERLAPS &amp; CONFLICT NOTES" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Shared asset paths are compatibility evidence. They are not proof that two mods do duplicate work, and they never add a risk score by themselves." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="OverlapCount" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
            </Grid>
            <StackPanel x:Name="OverlapPanel" Margin="0,12,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="QUARANTINED MODS" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Copies are hash-verified before the original leaves the load path. Restore returns the exact files to their original locations and never overwrites an existing path." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="QuarantineCount" FontSize="10.5" Foreground="{StaticResource Dim}" VerticalAlignment="Bottom"/>
            </Grid>
            <StackPanel x:Name="QuarantinePanel" Margin="0,12,0,0"/>

            <Grid Margin="0,24,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="BEFORE / AFTER COMPARISON" Style="{StaticResource Overline}"/>
                    <TextBlock Text="Manual PresentMon workflow. ZoneTune cannot drive an in-game benchmark reliably, so no result is generated or attributed automatically." Style="{StaticResource BodyDim}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="Open comparison folder" Click="OpenComparisons_Click" Padding="10,6"/>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PresentMonHint" Style="{StaticResource BodyDim}" VerticalAlignment="Center"/>
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource ButtonBase}" Content="Import baseline CSV" Click="ImportBefore_Click" Padding="11,7" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource ButtonBase}" Content="Import after CSV" Click="ImportAfter_Click" Padding="11,7" Margin="0,0,8,0"/>
                        <Button x:Name="CompareButton" Style="{StaticResource PrimaryButton}" Content="Compare captures" Click="Compare_Click" Padding="11,7" IsEnabled="False"/>
                    </WrapPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="LABEL" Style="{StaticResource Overline}"/>
                            <TextBox x:Name="ComparisonLabel" Height="32" Margin="0,4,0,0" Text="Mod comparison"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="SCENE / SETTINGS / MOD SET NOTES" Style="{StaticResource Overline}"/>
                            <TextBox x:Name="ComparisonNotes" Height="56" Margin="0,4,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                                     ToolTip="Same save, route, graphics settings, upscaler and warm-up. List the mods that were disabled."/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="ComparisonFiles" Style="{StaticResource Mono}" Margin="0,9,0,0" Text="No captures imported yet."/>
                    <TextBlock Text="PresentMon captures provide FPS and frame times. They do not contain GPU/CPU utilization or VRAM usage; if you need those, record them separately with CapFrameX/HWiNFO and put the values in the notes. ZoneTune will not invent them."
                               Style="{StaticResource BodyDim}" Margin="0,7,0,0"/>
                    <StackPanel x:Name="ComparisonPanel" Margin="0,10,0,0"/>
                    <TextBlock Text="A difference applies to the whole tested condition. Do not present it as a per-mod FPS gain, and do not expect it to repeat without the same route and settings." Style="{StaticResource BodyDim}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="RECENT COMPARISONS" Style="{StaticResource Overline}" Margin="0,18,0,0"/>
            <StackPanel x:Name="HistoryPanel" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>

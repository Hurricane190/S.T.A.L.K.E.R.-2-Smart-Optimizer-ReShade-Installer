<Window x:Class="ZoneTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ZoneTune — STALKER 2 Smart Optimizer"
        Width="1320" Height="860" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Accent" Grid.Column="0" Width="3" Height="16" CornerRadius="2"
                                        Background="Transparent" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Icon" Grid.Column="1" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="2" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#151D17"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A241C"/>
                                <Setter TargetName="Accent" Property="Background" Value="{StaticResource Amber}"/>
                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Amber}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202A22"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Border Grid.Row="0" Background="#0A0E0B" BorderBrush="#151D17" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="5" Background="#E3A33C">
                        <TextBlock Text="Z" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="Bold"
                                   Foreground="#151006" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ZONE/TUNE" FontFamily="{StaticResource DisplayFont}" FontSize="12.5" FontWeight="Bold"
                               Foreground="{StaticResource Text}" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    <Border Width="1" Height="12" Background="#263329" Margin="10,0"/>
                    <TextBlock Text="STALKER 2 SMART OPTIMIZER" FontSize="9.5" Foreground="{StaticResource Dim}"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TitleBarStatus" Text="" FontSize="10.5" Foreground="{StaticResource Dim}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True" Margin="0,0,6,0">
                    <Button x:Name="MinButton" Style="{StaticResource WindowButton}" Content="—" Click="MinButton_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="□" Click="MaxButton_Click" ToolTip="Maximize"/>
                    <Button x:Name="CloseButton" Style="{StaticResource WindowButton}" Content="✕" Click="CloseButton_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#0B0F0C" BorderBrush="#151D17" BorderThickness="0,0,1,0">
                <Grid Margin="0,18,0,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="22,0,18,18">
                        <TextBlock Text="WORKSPACE" Style="{StaticResource Overline}" />
                        <TextBlock Text="Zone diagnostics &amp; reversible tuning" Style="{StaticResource BodyDim}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavOptimize" Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Optimize" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavReShade" Style="{StaticResource NavItem}" Tag="&#xE91B;" Content="ReShade Manager" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStudio" Style="{StaticResource NavItem}" Tag="&#xE790;" Content="Preset Studio" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavMods" Style="{StaticResource NavItem}" Tag="&#xE71D;" Content="Installed Mods" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings &amp; Backups" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavReports" Style="{StaticResource NavItem}" Tag="&#xE9F9;" Content="Diagnostic Reports" Checked="Nav_Checked"/>

                        <Border Height="1" Background="#171F19" Margin="22,20,22,16"/>
                        <TextBlock Text="SAFETY" Style="{StaticResource Overline}" Margin="24,0,0,8"/>
                        <StackPanel Margin="24,0,20,0">
                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                                <TextBlock Text="Backups before every write" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                                <TextBlock Text="No mods are deleted" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                                <TextBlock Text="Effects are measured, not promised" FontSize="11" Foreground="{StaticResource Dim}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="18,0,18,0">
                        <Border Background="#101611" BorderBrush="#1E2A21" BorderThickness="1" CornerRadius="8" Padding="11,9">
                            <StackPanel>
                                <TextBlock Text="GAME" Style="{StaticResource Overline}"/>
                                <TextBlock x:Name="SidebarGame" Text="Detecting…" FontSize="11" Foreground="{StaticResource Dim}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SidebarScan" Text="Not scanned" FontSize="10" Foreground="#5F6F62" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="v1.0.0 · local-only · no telemetry" FontSize="9.5" Foreground="#4F5D51" Margin="2,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="30,22,30,16" Background="#090C0A">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="PageTitle" Text="Dashboard" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="PageSubtitle" Text="A clear picture of the Zone on your hardware." Style="{StaticResource BodyDim}"
                                       Margin="0,5,0,0" MaxWidth="720" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="ScanPill" Style="{StaticResource Chip}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ScanDot" Width="6" Height="6" Fill="{StaticResource Dim}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ScanPillText" Text="NOT SCANNED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Dim}"/>
                                </StackPanel>
                            </Border>
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="ScanButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Scan system" FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <ContentControl x:Name="ContentHost" Margin="0,0,0,0"/>
                    <ProgressBar x:Name="ScanProgress" VerticalAlignment="Top" Height="2" IsIndeterminate="True" Visibility="Collapsed"/>
                </Grid>

                <Border Grid.Row="2" Background="#0B0F0C" BorderBrush="#151D17" BorderThickness="0,1,0,0" Padding="30,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="Ready." FontSize="10.5" Foreground="{StaticResource Dim}" Margin="7,0,0,0"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Logs" FontSize="10" Foreground="#5D6C60" VerticalAlignment="Center" Cursor="Hand"
                                       MouseLeftButtonUp="OpenLogs_Click" ToolTip="Open the ZoneTune log folder"/>
                            <TextBlock Text="·" FontSize="10" Foreground="#334034" Margin="8,0"/>
                            <TextBlock Text="Backups" FontSize="10" Foreground="#5D6C60" VerticalAlignment="Center" Cursor="Hand"
                                       MouseLeftButtonUp="OpenBackups_Click"/>
                            <TextBlock Text="·" FontSize="10" Foreground="#334034" Margin="8,0"/>
                            <TextBlock x:Name="FooterVersion" Text="v1.0.0" FontSize="10" Foreground="#334034" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
